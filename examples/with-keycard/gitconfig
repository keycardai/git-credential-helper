# git config for the keycard-git demo: credentials from Keycard.
#
# Use it in place of your global config, from this directory:
#
#   GIT_CONFIG_GLOBAL="$PWD/gitconfig" git clone "$(git remote get-url origin)" demo
#
# Identical to ../without-keycard/gitconfig apart from the keycard-git helper.

[credential]
	# Clear every helper configured before this file, such as osxkeychain in
	# the system config.
	helper =
	# Fail instead of prompting for a username and password.
	interactive = false

# keycard-git answers for github.com.
#
# Replace the zone ID with your own Keycard zone's. Without --zone, the
# Keycard CLI looks for $ZONE or a keycard.toml in the directory git runs in;
# naming it here makes the demo work without either.
[credential "https://github.com"]
	helper = "!keycard-git credential --zone skh42y2hkb19n1wp656zekyuxt"

# Send SSH remotes over HTTPS, so no SSH key is used and every operation goes
# through keycard-git.
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
